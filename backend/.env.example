# Django
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
POSTGRES_DB=tech_store
POSTGRES_USER=tech_store_user
POSTGRES_PASSWORD=replace-with-a-local-database-password
# Docker Compose overrides this with the PostgreSQL service name.
POSTGRES_HOST=localhost
# Docker Compose exposes PostgreSQL on this host port. Use 5432 for a standalone
# local PostgreSQL installation instead.
POSTGRES_PORT=5433
